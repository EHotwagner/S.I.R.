      ],
      "linkedEvidenceIds": [
        "EV003"
      ]
    },
    {
      "id": "FR-004",
      "title": "The server MUST enforce one current connection generation per session, reject superseded-token replay, and allow the current holder to reconnect and resync. (Stories: US-002; Acceptance: AC-004)",
      "text": "The server MUST enforce one current connection generation per session, reject superseded-token replay, and allow the current holder to reconnect and resync. (Stories: US-002; Acceptance: AC-004)",
      "acceptanceCriteria": [
        "AC-004"
      ],
      "priority": null,
