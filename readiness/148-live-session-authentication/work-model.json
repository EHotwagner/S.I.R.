  "requirements": [
    {
      "id": "FR-001",
      "title": "The server MUST require and authorize a principal for the requested actor and match before creating a live session and issuing a scoped expiring admission credential. (Stories: US-001; Acceptance: AC-001)",
      "text": "The server MUST require and authorize a principal for the requested actor and match before creating a live session and issuing a scoped expiring admission credential. (Stories: US-001; Acceptance: AC-001)",
      "acceptanceCriteria": [
        "AC-001"
      ],
      "priority": null,
      "classification": [],
      "source": "work/148-live-session-authentication/spec.md",
      "sourceLocation": {
        "line": 37,
        "column": 1
      },
      "linkedTaskIds": [
        "T001"
      ],
      "linkedEvidenceIds": [
        "EV001"
      ]
    },
    {
      "id": "FR-002",
      "title": "The browser MUST supply the admission credential via SignalR\u0027s supported access-token metadata and MUST NOT put credentials in query strings, the DOM, logs, or diagnostics. (Stories: US-001; Acceptance: AC-002)",
      "text": "The browser MUST supply the admission credential via SignalR\u0027s supported access-token metadata and MUST NOT put credentials in query strings, the DOM, logs, or diagnostics. (Stories: US-001; Acceptance: AC-002)",
      "acceptanceCriteria": [
        "AC-002"
      ],
      "priority": null,
      "classification": [],
      "source": "work/148-live-session-authentication/spec.md",
      "sourceLocation": {
        "line": 38,
        "column": 1
      },
      "linkedTaskIds": [
        "T002"
      ],
      "linkedEvidenceIds": [
        "EV002"
      ]
    },
    {
      "id": "FR-003",
      "title": "The hub MUST validate the credential and its principal/session/actor binding on every connection and every intent, and MUST reject invalid, expired, revoked, or cross-actor use without state mutation. (Stories: US-002; Acceptance: AC-003)",
      "text": "The hub MUST validate the credential and its principal/session/actor binding on every connection and every intent, and MUST reject invalid, expired, revoked, or cross-actor use without state mutation. (Stories: US-002; Acceptance: AC-003)",
      "acceptanceCriteria": [
        "AC-003"
      ],
      "priority": null,
      "classification": [],
      "source": "work/148-live-session-authentication/spec.md",
      "sourceLocation": {
        "line": 39,
