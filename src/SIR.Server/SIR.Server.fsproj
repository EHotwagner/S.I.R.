<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <Compile Include="LiveAuthentication.fs" />
    <Compile Include="LiveAuthority.fs" />
    <Compile Include="GameHub.fs" />
    <Compile Include="Program.fs" />
    <Content Include="../../artifacts/client/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SIR.Match/SIR.Match.fsproj" />
    <ProjectReference Include="../SIR.Protocol/SIR.Protocol.fsproj" />
  </ItemGroup>
</Project>
