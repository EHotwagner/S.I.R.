<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);FABLE_COMPILER;SIR_WEB_CLIENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SIR.Protocol/Http.fs" Link="Protocol/Http.fs" />
    <Compile Include="../SIR.Protocol/Realtime.fs" Link="Protocol/Realtime.fs" />
    <Compile Include="SignalR.fs" />
    <Compile Include="LiveApi.fs" />
    <Compile Include="LiveSession.fs" />
    <Compile Include="LiveSessionView.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="Runner.fs" />
    <Compile Include="FeatureLoader.fsi" />
    <Compile Include="FeatureLoader.fs" />
    <Compile Include="BrowserInfrastructure.fs" />
    <Compile Include="DocumentationFeatureContract.fs" />
    <Compile Include="AppTypes.fs" />
    <Compile Include="EnvironmentFeatureContract.fs" />
    <Compile Include="RulesWorkbenchView.fs" />
    <Compile Include="ClientFeatureRuntime.fs" />
    <Compile Include="AppShell.fs" />
    <Compile Include="WorkspaceTransitions.fs" />
    <Compile Include="CommandRegistry.fs" />
    <Compile Include="ModeAdapters.fs" />
    <Compile Include="SceneAdapters.fs" />
    <Compile Include="PanelViews.fs" />
    <Compile Include="TacticalOverlayView.fs" />
    <Compile Include="TacticalEnvironmentView.fs" />
    <Compile Include="DocsView.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SIR.Client/SIR.Client.fsproj" />
    <ProjectReference Include="../SIR.Domain/SIR.Domain.fsproj" />
    <ProjectReference Include="../SIR.Replay.Core/SIR.Replay.Core.fsproj" />
    <ProjectReference Include="../SIR.Simulation/SIR.Simulation.fsproj" />
    <PackageReference Include="Fable.Browser.Dom" />
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Elmish" />
    <PackageReference Include="Fable.Elmish.React" />
    <PackageReference Include="Feliz" />
    <PackageReference Include="Thoth.Json" />
  </ItemGroup>
</Project>
