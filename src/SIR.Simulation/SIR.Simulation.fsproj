<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Include="Substrate.fs" />
    <Compile Include="CombatRules.fsi" />
    <Compile Include="CombatRules.fs" />
    <Compile Include="SpatialQuery.fsi" Condition="'$(SpatialQueryImplementation)' == ''" />
    <Compile Include="SpatialQuery.fs" Condition="'$(SpatialQueryImplementation)' == ''" />
    <Compile Include="$([System.IO.Path]::ChangeExtension('$(SpatialQueryImplementation)', '.fsi'))" Link="SpatialQuery.fsi" Condition="'$(SpatialQueryImplementation)' != ''" />
    <Compile Include="$(SpatialQueryImplementation)" Link="SpatialQuery.fs" Condition="'$(SpatialQueryImplementation)' != ''" />
    <Compile Include="TacticalEnvironment.fsi" />
    <Compile Include="TacticalEnvironment.fs" />
    <Compile Include="AwarenessReaction.fsi" />
    <Compile Include="AwarenessReaction.fs" />
    <Compile Include="CombatModel.fsi" />
    <Compile Include="CombatModel.fs" />
    <Compile Include="Simulation.fs" />
    <Compile Include="MapScale.fs" />
    <Compile Include="CapabilityExecution.fs" />
    <Compile Include="Replay.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SIR.Domain/SIR.Domain.fsproj" />
    <PackageReference Include="FS.GG.Game.Core" />
    <PackageReference Include="FS.GG.Governance.ReferenceGateSet" PrivateAssets="all" />
  </ItemGroup>
</Project>
